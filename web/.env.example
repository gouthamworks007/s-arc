# S-ARC Database Connections (PostgreSQL legacy / Cloudflare D1)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/s_arc_db?schema=public"

# Cloudflare D1 Native Edge Database
CLOUDFLARE_ACCOUNT_ID="12e1734f2c0cdf394e243e50f5af6e86"
CLOUDFLARE_D1_DATABASE_ID="496764fb-0e0f-408d-b5c5-8e8f998526d6"
CLOUDFLARE_D1_DATABASE_NAME="s-arc-db"
# Optional API Token for remote API queries outside Cloudflare Workers runtime
CLOUDFLARE_API_TOKEN=""

# JSON Web Token Secret for RBAC Session Encryption (Minimum 32 characters in production)
JWT_SECRET="s-arc-secure-production-jwt-key-2026-south-arch-32chars"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Satellite GIS Tile Provider Configuration
# Choose one of the compliant high-resolution providers below:
# 1. Mapbox Satellite Streets (Commercial SLA)
# NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1Ijo..."
# 2. MapTiler Satellite Hybrid (Official MapLibre Partner)
# NEXT_PUBLIC_MAPTILER_KEY="your_maptiler_key"
# 3. Custom Tile Server URL template (e.g. self-hosted tile server or enterprise proxy)
# NEXT_PUBLIC_SATELLITE_TILE_URL="https://tiles.yourdomain.com/{z}/{x}/{y}.png"
