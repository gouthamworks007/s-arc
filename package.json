{
  "name": "s-arc",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=web",
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "test:phase1": "node scripts/verify-phase1.mjs",
    "test:upload": "node scripts/verify-upload.mjs",
    "test:auth": "node scripts/verify-auth.mjs",
    "test:architect": "node scripts/verify-architect.mjs",
    "test:database": "node scripts/verify-database.mjs",
    "test:security": "node scripts/verify-security.mjs",
    "test:all": "node scripts/verify-phase1.mjs && node scripts/verify-upload.mjs",
    "admin:provision": "npm run admin:provision --workspace=web",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "d1:migrate:all": "wrangler d1 execute s-arc-db --remote --file=./migrations/0001_initial_schema.sql && wrangler d1 execute s-arc-db --remote --file=./migrations/0002_seed.sql && wrangler d1 execute s-arc-db --remote --file=./migrations/0003_saved_plots.sql && wrangler d1 execute s-arc-db --remote --file=./migrations/0004_cad_deliverables.sql",
    "d1:migrate:initial": "wrangler d1 execute s-arc-db --remote --file=./migrations/0001_initial_schema.sql",
    "d1:migrate:seed": "wrangler d1 execute s-arc-db --remote --file=./migrations/0002_seed.sql",
    "d1:migrate:plots": "wrangler d1 execute s-arc-db --remote --file=./migrations/0003_saved_plots.sql",
    "d1:migrate:cad": "wrangler d1 execute s-arc-db --remote --file=./migrations/0004_cad_deliverables.sql",
    "d1:status": "wrangler d1 execute s-arc-db --remote --command=\"SELECT * FROM users;\""
  }
}
