{
  "name": "s-arc",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace=web",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "dev": "npm run dev --workspace=web",
    "d1:migrate": "wrangler d1 execute s-arc-db --remote --file=./migrations/0001_initial_schema.sql",
    "d1:seed": "wrangler d1 execute s-arc-db --remote --file=./migrations/0002_seed.sql",
    "d1:status": "wrangler d1 execute s-arc-db --remote --command=\"SELECT * FROM users;\""
  }
}
